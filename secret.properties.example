# Copy this file to `secret.properties` (which is gitignored) and fill in real values.
# The build reads these for the signPlugin / publishPlugin tasks. Env vars of the same name also work.
#
# Do NOT commit secret.properties or the certificate files.

# JetBrains Marketplace permanent token (Marketplace profile -> My Tokens).
PUBLISH_TOKEN=

# Paths (relative to project root) to your signing certificate and private key.
certificateChainFile=secrets/chain.crt
privateKeyFile=secrets/private.pem

# Passphrase you set when generating the private key.
PRIVATE_KEY_PASSWORD=
